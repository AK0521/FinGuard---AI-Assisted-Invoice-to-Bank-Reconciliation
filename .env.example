# Optional backend settings
# Copy to .env only if you use your own process manager that loads env files.
# The app also works without this file.

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
FINGUARD_DISABLE_OLLAMA=0

# Optional: override the SQLite path. Leave unset for the default ./data/finguard.sqlite3.
# FINGUARD_DB=/absolute/path/to/finguard.sqlite3

# Optional frontend setting for deployed/non-default API hosts.
VITE_API_BASE=http://127.0.0.1:8000
